NODE_ENV=development
PORT=4173
DATABASE_PATH=./data/kijani-pay.sqlite
MAX_UPLOAD_BYTES=10485760
MAX_SESSION_SIZE=250
MAX_PAYMENT_AMOUNT=150000
PAYMENT_TIMEOUT_SECONDS=300
CORS_ORIGIN=http://localhost:4173

# Require this header on operator API requests in production.
# Generate with: openssl rand -hex 32
OPERATOR_API_KEY=

# PayHero server-side configuration. Never put these in frontend files.
# Add these same values in Vercel > Settings > Environment Variables.
PAYHERO_BASE_URL=https://your-payhero-base-url
PAYHERO_PAYMENT_PATH=/api/v2/payments
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_ACCOUNT_ID=
PAYHERO_CHANNEL_ID=
PAYHERO_WEBHOOK_SECRET=